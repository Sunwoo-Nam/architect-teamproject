  <diagram id="poc-stage-roadmap" name="단계 의존과 검증 명제">
    <mxGraphModel dx="1450" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="v1" value="&lt;b&gt;V1&lt;/b&gt; 전수 열거 없이도&lt;br&gt;같은 합의에 도달한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="80" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;V2&lt;/b&gt; predicate 절단으로&lt;br&gt;후보 수·라운드가 준다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;V3&lt;/b&gt; 단계 분리가 메모리에 유리하면서, 계획 최적성 손실이 측정 범위 안이다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="80" width="545" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;V4&lt;/b&gt; 상태를 분리해도&lt;br&gt;일관되게 동작한다&lt;br&gt;&lt;i&gt;(안 1에 정의 없음)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1165" y="80" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;Stage 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;단일 단계 협상 커널&lt;br&gt;CandidateSpace Provider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Stage 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;constraint hint의&lt;br&gt;공간 절단" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Stage 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;PlanGraph 2단계 실행&lt;br&gt;영화 → 식사" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Stage 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;backtracking과&lt;br&gt;no-good" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Stage 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;정확도 측정 하네스&lt;br&gt;K 값 재산정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="795" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Stage 6&lt;/b&gt;&lt;br&gt;&lt;br&gt;시나리오 생성기&lt;br&gt;N자 확장" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;Stage 7&lt;/b&gt;&lt;br&gt;&lt;br&gt;계획 상태 분리&lt;br&gt;&lt;i&gt;산출물은 설계 발견&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1165" y="190" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;Stage 8&lt;/b&gt; — LLM 기반 PlanGraph 생성&lt;br&gt;&lt;br&gt;어휘 크기 위반율 · 민감 어휘 생성 · 바인딩 정합성&lt;br&gt;결정론 템플릿 대비 계획 최적성" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="450" width="400" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="진입: 배치 크기 K 초기값" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="335" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="진입: fixed hint 철회 절차" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="335" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="진입: fixed hint의 후속 단계 승계 범위" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="335" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="진입: backtracking 상한값" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="335" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="진입: N자에서 fixed 충돌 처리" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="335" width="170" height="55" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Stage 1~7은 LLM을 쓰지 않는다. 측정 대상이 후보 공간 크기·라운드 수·최적성 거리이므로 모델 변동성이 섞이면 인과를 분리할 수 없다.&lt;br&gt;Stage 1~6은 단일 프로세스에서 계획 상태를 공유하므로, 잠정 합의의 양자 동기화 문제가 구조적으로 드러나지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;dashed=1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="610" width="1280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="V1~V3 확인 후 착수" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673A6;dashed=1;fontSize=11;" edge="1" parent="1" source="s5" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="poc-conceptual-view" name="개념 구조">
    <mxGraphModel dx="1440" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dev" value="단말 내부 — 자사 PPA (온디바이스)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="950" height="590" as="geometry" />
        </mxCell>
        <mxCell id="off" value="오프라인 평가 — 런타임 밖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#AAAAAA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lgb" value="범례" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="1320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="input" value="계획 의도와 시나리오&lt;br&gt;&lt;i&gt;IDS Intent는 본 PoC의 입력이며 범위 밖&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cplan" value="&lt;b&gt;계획 관리&lt;/b&gt;&lt;br&gt;계획 그래프와 단계 의존을 보관하고, 단계를 순서대로 실행한다.&lt;br&gt;합의는 전체 완성 전까지 잠정 상태로 두며, 후속 단계가 불가능하면 선행 단계로 되돌아간다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="225" width="880" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ccomp" value="&lt;b&gt;단계 의제 생성&lt;/b&gt;&lt;br&gt;&lt;br&gt;상위 합의 · 의존 바인딩 · 로컬 컨텍스트를 합쳐&lt;br&gt;이번 단계에서 다룰 값의 범위와 효용을 만든다.&lt;br&gt;&lt;b&gt;자원 상한을 강제하는 지점&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="355" width="420" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cspace2" value="&lt;b&gt;후보 공간 관리&lt;/b&gt;&lt;br&gt;&lt;br&gt;유효한 값 조합의 범위를 계산하고,&lt;br&gt;요청받은 만큼씩 후보를 꺼내 준다.&lt;br&gt;&lt;b&gt;모든 조합을 한꺼번에 만들지 않는다&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="355" width="430" height="105" as="geometry" />
        </mxCell>
        <mxCell id="chint" value="&lt;b&gt;제약 힌트 처리&lt;/b&gt;&lt;br&gt;&lt;br&gt;상대가 고정으로 표시한 항목을 고정 조건으로 바꾸고,&lt;br&gt;내보낼 표시를 만든다.&lt;br&gt;조건을 만족하는 조합이 없으면 해당 분기를 거절한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="485" width="420" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cstrat" value="&lt;b&gt;협상 전략&lt;/b&gt;&lt;br&gt;&lt;br&gt;받은 후보 중에서 무엇을 제안할지 고르고,&lt;br&gt;상대 제안을 받아들일지 판단한다.&lt;br&gt;&lt;b&gt;수락 판단의 기준은 선호 모델이다&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="485" width="430" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cpref" value="&lt;b&gt;선호 모델 — 비공개&lt;/b&gt;&lt;br&gt;효용 함수 · 불가 조건 · 유보값 · 양보 정책. 사용자의 사정이 들어가는 곳이다.&lt;br&gt;외부로 나가지 않으며, 상대는 우리가 무엇을 제안하고 무엇을 제안하지 않는지만 본다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="615" width="880" height="85" as="geometry" />
        </mxCell>

        <mxCell id="cwire" value="&lt;b&gt;외부로 나가는 것&lt;/b&gt;&lt;br&gt;&lt;br&gt;유효 범위 안의 오퍼&lt;br&gt;항목별 고정 / 변경가능 표시&lt;br&gt;&lt;br&gt;&lt;i&gt;효용·유보값·사유·계획 상태는 나가지 않는다&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="225" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cproto" value="&lt;b&gt;협상 프로토콜&lt;/b&gt;&lt;br&gt;(NegMAS)&lt;br&gt;&lt;br&gt;교대 제안 · 다자 · 라운드 상한" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="355" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cpeer" value="&lt;b&gt;상대 PPA&lt;/b&gt;&lt;br&gt;(자사 동일 구현)&lt;br&gt;&lt;br&gt;고정 조건을 만족할 수 없으면&lt;br&gt;해당 오퍼 또는 계획 분기를 거절한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="485" width="330" height="105" as="geometry" />
        </mxCell>

        <mxCell id="copt" value="&lt;b&gt;최적성 평가&lt;/b&gt;&lt;br&gt;단계 최적성과 계획 전체 최적성" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="815" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cbase" value="&lt;b&gt;기준선 실행&lt;/b&gt;&lt;br&gt;라운드 상한 손실과 전략 손실을 분리한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="815" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="coffnote" value="전 참여자의 효용 함수와 기준 범위 전량 열거가 필요하다.&lt;br&gt;단말 런타임에서는 계산할 수 없다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="815" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="clg1" value="우리 구현" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="960" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="clg2" value="NegMAS 제공" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="345" y="960" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="clg3" value="외부 (상대 기기)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="960" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="clg4" value="비공개 — 단말 밖으로 나가지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#B85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="835" y="960" width="270" height="32" as="geometry" />
        </mxCell>
        <mxCell id="clg5" value="오프라인 전용" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="960" width="210" height="32" as="geometry" />
        </mxCell>

        <mxCell id="q0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;strokeColor=#666666;" edge="1" parent="1" source="input" target="cplan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="① 단계 1건" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;strokeColor=#333333;fontSize=12;fontStyle=1" edge="1" parent="1" source="cplan" target="ccomp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="② 유효 범위 (상한 적용)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#333333;fontSize=12;fontStyle=1" edge="1" parent="1" source="ccomp" target="cspace2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="③ 고정 조건 → 추가 축소" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8;strokeColor=#333333;fontSize=12;fontStyle=1" edge="1" parent="1" source="chint" target="cspace2">
