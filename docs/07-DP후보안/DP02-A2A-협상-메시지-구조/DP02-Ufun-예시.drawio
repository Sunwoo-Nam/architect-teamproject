<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Ufun 예시" id="ufun-example">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Ufun(효용함수) — LinearAdditive: 이슈별 가중치 × 값함수의 합" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="formula" value="u(ω) = w_일정 · v_일정(일정) + w_위치 · v_위치(위치)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="weights" value="가중치:  w_일정 = 0.6,   w_위치 = 0.4   (합 = 1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="98" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v1h" value="v_일정 (값함수)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="132" width="250" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v1v" value="오전 = 0.3,   오후 = 0.6,   저녁 = 1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="164" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v2h" value="v_위치 (값함수)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="370" y="132" width="250" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v2v" value="강남 = 1.0,   서초 = 0.6,   송파 = 0.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="164" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="u(저녁, 강남) = 0.6 · 1.0 + 0.4 · 1.0 = 1.00   ★ 최선" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ex2" value="u(오후, 서초) = 0.6 · 0.6 + 0.4 · 0.6 = 0.60" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ex3" value="u(오전, 송파) = 0.6 · 0.3 + 0.4 · 0.3 = 0.30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="값함수와 가중치(= ufun)는 단말 내부에만 존재하며 외부로 전송되지 않는다. 전체 표를 저장하는 것이 아니라 outcome을 넣으면 값이 계산되는 함수다. 외부로 나가는 것은 offer(OutcomeSpace 유효 값)뿐이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="344" width="620" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
