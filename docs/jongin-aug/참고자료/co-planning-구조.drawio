        </mxCell>
        <mxCell id="cout" value="출력 (NegMAS Scenario)&lt;br&gt;&lt;br&gt;· OutcomeSpace (상한 적용)&lt;br&gt;· ufun (비공개, 로컬)&lt;br&gt;· mechanism params&lt;br&gt;&#160;&#160;(n_steps / time_limit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="350" width="235" height="135" as="geometry" />
        </mxCell>
        <mxCell id="oomnote" value="OOM 통제점&lt;br&gt;&lt;br&gt;outcome space는 &lt;b&gt;생성되기 전&lt;/b&gt;에 상한이 정해진다.&lt;br&gt;NegMAS는 to_discrete / limit_cardinality / sample 등&lt;br&gt;도구는 제공하지만, 상한을 강제하는 지점은 제공하지 않는다.&lt;br&gt;세션을 결합할수록 공간은 곱셈으로 증가한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="360" width="370" height="115" as="geometry" />
        </mxCell>

        <mxCell id="neg" value="협상 Negotiator (자사 PPA)&lt;br&gt;&lt;br&gt;· 후보 생성 (상한 적용 공간 내)&lt;br&gt;· 수신 fixed → 후보 공간 절단&lt;br&gt;· 수락/거절은 ufun이 결정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="590" width="265" height="125" as="geometry" />
        </mxCell>
        <mxCell id="mech" value="SAOMechanism (NegMAS)&lt;br&gt;N자 협상 · 도중 참여/이탈 · n_steps / time_limit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="570" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="msg" value="Offer 메시지&lt;br&gt;&lt;br&gt;ExtendedOutcome(outcome, data={constraint_hint})&lt;br&gt;issue별 fixed / relaxable&lt;br&gt;&lt;i&gt;운반은 NegMAS, 어휘·의미론·검증은 우리 구현&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;dashed=1;fontSize=11;" vertex="1" parent="1">
