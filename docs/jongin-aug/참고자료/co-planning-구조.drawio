        </mxCell>
        <mxCell id="gate" value="승인 게이트&lt;br&gt;(사용자 확인)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
