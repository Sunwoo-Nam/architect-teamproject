          <mxGeometry x="80" y="195" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="협상 중 가용성 조회 (읽기 전용)&lt;br&gt;소진된 값을 후보 목록에서 제거한다. 자원을 점유하지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="285" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="사용자 승인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="390" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="외부 예약 일괄 실행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="190" y="475" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="일부 예약 실패 시 해당 단계만 재협상&lt;br&gt;(사용자 승인 이후 시점이므로 승인을 다시 받아야 한다)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="565" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="확정 실행 전까지 외부 세계에 변화가 없다.&lt;br&gt;협상 중 되돌리기 비용은 발생하지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="665" width="560" height="60" as="geometry" />
        </mxCell>

