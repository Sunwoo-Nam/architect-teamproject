        <mxCell id="b8" value="되돌려야 하는 경우&lt;br&gt;취소 비용 산정 → 자기 사용자 결정 → 상대에게 취소 동의 요청" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=12;" vertex="1" parent="1">
