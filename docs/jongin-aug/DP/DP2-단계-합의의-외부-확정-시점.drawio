        <mxCell id="b2" value="자원 경합 판단&lt;br&gt;잔여 수량 또는 소진 속도를 임계값과 비교한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="190" width="560" height="60" as="geometry" />
        </mxCell>
