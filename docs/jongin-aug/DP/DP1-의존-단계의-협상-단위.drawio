          <mxGeometry x="760" y="105" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_i2" value="단계 2 쟁점" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="105" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_agenda" value="결합 의제 — 두 단계의 쟁점 전부" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="760" y="200" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_pre" value="값 범위 축소로 바꿀 수 있는 의존은 협상 전에 값 목록에서 제거" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="295" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_cons" value="남은 의존은 쟁점 사이의 제약으로 표현" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="385" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_supply" value="후보 공급&lt;br&gt;쟁점별 값을 선호 기여도 순으로 정렬하고 상위 조합부터 하나씩 꺼낸다.&lt;br&gt;정해지지 않은 쟁점은 남은 값의 최대 기여도 합을 상계로 둔다.&lt;br&gt;한 단계가 최소 만족 수준에 미달하면 그 분기를 중단한다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="475" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b_neg" value="단일 협상" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
