<mxfile host="app.diagrams.net">
  <diagram id="36A" name="36-A. 경계 적용형 — 개입을 Queue에 보관했다가 라운드 경계(스냅샷 지점)에서 일괄 반영">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="36-A. 경계 적용형 — 개입을 Queue에 보관했다가 라운드 경계(스냅샷 지점)에서 일괄 반영" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1050" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="공통 component (모든 대안 동일)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="이 대안의 고유 component" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="260" y="52" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="u" value="사용자 (개입 입력: 중단·조건 변경·거절)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="core" value="협상 세션 진행 (공통)&#10;라운드 실행 · 제안/평가 · 완결 판정" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="q" value="Intervention Queue&#10;(개입 입력 보관)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g" value="Boundary Gate&#10;(라운드 경계에서만 반영)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="160" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s" value="Snapshot Store&#10;(라운드 경계마다 확정 상태 저장)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="개입 입력 저장" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0066cc;" edge="1" parent="1" source="u" target="q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="경계 도달 시 꺼냄" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0066cc;" edge="1" parent="1" source="q" target="g">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="일괄 반영 후 다음 라운드" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0066cc;strokeWidth=2;" edge="1" parent="1" source="g" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="라운드 경계 상태 저장" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0066cc;dashed=1;" edge="1" parent="1" source="core" target="s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="차이점: 진행 중 라운드는 건드리지 않음 — 반영이 결정적이고 기록이 깔끔하나, 개입이 최대 1라운드 지연됨" style="text;html=1;fontSize=11;fontColor=#990000;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="1000" height="40" as="geometry" />
