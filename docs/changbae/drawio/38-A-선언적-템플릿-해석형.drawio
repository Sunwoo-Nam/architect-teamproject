          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="로드" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0066cc;" edge="1" parent="1" source="r" target="i">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
