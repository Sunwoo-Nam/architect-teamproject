        <mxCell id="r4b" value="제출 N-1건 · 1 phase (판정은 담당자 로컬)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
