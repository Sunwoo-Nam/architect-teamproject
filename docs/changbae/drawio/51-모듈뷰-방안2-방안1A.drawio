        <mxCell id="r3b" value="Blackboard에 제안자 귀속이 붙은 누적 제안이 남는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
