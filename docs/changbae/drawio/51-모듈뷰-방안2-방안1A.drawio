        </mxCell>
        <mxCell id="r4c" value="배포 N-1 + 회신 N-1 · 2 phase, 바퀴마다 수집 1 phase가 선행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
