<mxfile host="app.diagrams.net">
  <diagram id="51MV" name="51 모듈 뷰 — 방안 2 vs 방안 1-A">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="51. 설계 후보 1 — 모듈 뷰: 방안 2(누적 공통제안형) vs 방안 1-A(순차 SAO 투표형)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="두 방안은 같은 협상 코어(아래 녹색 층)를 공유하고, 담당자·참여자 단말의 고유 모듈(주황)과 상태 보관 방식(파랑)만 다르다." style="text;html=1;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lg1" value="공통 모듈 (두 방안 동일)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="190" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="이 방안의 고유 모듈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="68" width="180" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="상태·저장소 모듈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="68" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="실선 화살표 = uses(의존)&#160;&#160;·&#160;&#160;점선 화살표 = 메시지 인터페이스를 경유한 원격 uses&#160;&#160;·&#160;&#160;박스 중첩 = is-part-of" style="text;html=1;fontSize=10;align=left;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="605" y="68" width="700" height="24" as="geometry" />
        </mxCell>

        <!-- ================= 좌: 방안 2 ================= -->
        <mxCell id="hdrL" value="방안 2 — 누적 공통제안형 · Blackboard 스타일 (문서 51 §2·§4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="106" width="790" height="28" as="geometry" />
        </mxCell>

        <mxCell id="cL1" value="담당자 단말 P0 — Blackboard 담당" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="142" width="790" height="190" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="Round Controller&#10;라운드 개시·마감,&#10;바퀴(sweep) 진행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cL1">
          <mxGeometry x="15" y="38" width="175" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Submission Store 〈상태〉&#10;참여자 → 제안 누적 집합&#10;(제안자 귀속 있음 · 라운드 넘어 유지)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="cL1">
          <mxGeometry x="200" y="38" width="195" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="Unanimity Judge&#10;누적 집합의 전원 교집합&#10;= 만장일치 성립" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cL1">
          <mxGeometry x="405" y="38" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="Final Notifier&#10;성립·결렬 통지&#10;(N-1건 · 1회)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cL1">
          <mxGeometry x="595" y="38" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="Tie Resolver — 공통 TieBreaker에 위임&#10;순위합 최소 → 표준편차 최소 → 결선투표&#10;(라운드=순위 규칙으로 전원의 순위를 복원할 수 있어 결정론적)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cL1">
          <mxGeometry x="405" y="112" width="370" height="62" as="geometry" />
        </mxCell>

        <mxCell id="cL2" value="참여자 단말 P1 … P(N-1)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="790" height="155" as="geometry" />
        </mxCell>
        <mxCell id="LP1" value="Submitter&#10;순위 커서가 준 후보 1개를 제출&#10;(제출이 곧 수락 의사)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cL2">
          <mxGeometry x="200" y="30" width="195" height="58" as="geometry" />
        </mxCell>
        <mxCell id="LP2" value="투표 모듈·수신 모듈이 없다&#10;제출 자격 규칙이 수락 의사를 보장 → O/X 교환 불필요&#10;라운드 결과 수신 경로도 없음 — 최종 통지만 받는다" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontSize=10;fontColor=#555555;align=left;spacingLeft=6;" vertex="1" parent="cL2">
          <mxGeometry x="405" y="30" width="370" height="58" as="geometry" />
        </mxCell>
        <mxCell id="LP3" value="이 방안의 참여자 고유 모듈은 Submitter 하나뿐 — Preference Ranker · Threshold Controller · Submission Cursor는 아래 공통 코어를 그대로 쓴다." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#cccccc;fontSize=10;fontColor=#777777;align=left;spacingLeft=6;" vertex="1" parent="cL2">
          <mxGeometry x="15" y="98" width="760" height="42" as="geometry" />
        </mxCell>

        <!-- ================= 우: 방안 1-A ================= -->
        <mxCell id="hdrR" value="방안 1-A — 순차 SAO 투표형 · 무 Blackboard (문서 51 §3-1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="106" width="790" height="28" as="geometry" />
        </mxCell>

        <mxCell id="cR1" value="담당자 단말 P0 — SAO 세션 담당 (양자 채널 N-1개, 공유 게시판 없음)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="142" width="790" height="190" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="Sweep Collector&#10;바퀴 시작 1회 수집&#10;(N-1건 · 1 phase)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="15" y="38" width="175" height="62" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="Anonymizing Offer Composer&#10;모인 후보 → 제안자 귀속을 제거한&#10;익명 후보 목록 (= SAO offer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="200" y="38" width="195" height="62" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="Vote Aggregator&#10;O/X 번들 집계 → 전원 O 후보 판정&#10;동률 시 공통 TieBreaker 호출" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="405" y="38" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="Final Notifier&#10;성립 시에만 통지&#10;(미성립 공지 없음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="595" y="38" width="180" height="62" as="geometry" />
        </mxCell>
        <mxCell id="R5" value="Carry Buffer 〈상태〉&#10;이번 라운드 후보 집합&#10;— 라운드 단위로 휘발" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="200" y="112" width="195" height="62" as="geometry" />
        </mxCell>
        <mxCell id="R6" value="Delivered Set 〈상태〉 — 담당자가 누적 수신한 제안&#10;복구 스냅샷·부하/노출 계측용이며 성립 판정에는 쓰이지 않는다&#10;(방안 2의 Submission Store와 역할이 다른 지점)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="cR1">
          <mxGeometry x="405" y="112" width="370" height="62" as="geometry" />
        </mxCell>

        <mxCell id="cR2" value="참여자 단말 P1 … P(N-1)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="400" width="790" height="155" as="geometry" />
        </mxCell>
        <mxCell id="R9" value="Counter-Offer Composer&#10;다음 순위 후보 1개&#10;(공통 Submission Cursor 사용)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR2">
          <mxGeometry x="15" y="26" width="175" height="56" as="geometry" />
        </mxCell>
        <mxCell id="R7" value="Offer Receiver&#10;익명 후보 목록 수신&#10;(누가 냈는지는 알 수 없음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR2">
          <mxGeometry x="200" y="26" width="195" height="56" as="geometry" />
        </mxCell>
        <mxCell id="R10" value="Reply Packer&#10;O/X 번들 + 다음 후보를&#10;한 메시지로 결합" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR2">
          <mxGeometry x="405" y="26" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="R11" value="SAO 메시지 의미론&#10;accept/reject + counter-offer&#10;(결합 유실 위험 지점)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontSize=10;fontColor=#555555;" vertex="1" parent="cR2">
          <mxGeometry x="595" y="26" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="R8" value="Vote Bundler — 받은 후보 전부에 대해 O/X 산출 (공통 Acceptance Evaluator 재사용: u(c) ≥ revised threshold)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="cR2">
          <mxGeometry x="200" y="100" width="385" height="44" as="geometry" />
        </mxCell>

