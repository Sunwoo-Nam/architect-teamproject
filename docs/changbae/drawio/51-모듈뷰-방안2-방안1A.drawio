        <mxCell id="r2b" value="전원이 그 후보를 직접 제안했을 때 — 보수적이고 늦다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
