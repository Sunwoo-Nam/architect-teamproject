<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="quality-tradeoffs" name="05 품질속성 트레이드오프">
    <mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="방안 1-A vs 방안 2 — 품질속성 트레이드오프" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="수치·규칙으로 확정된 사항과 벤치마크로 확인해야 할 사항을 구분한다. 평가 전에 임의의 우열 점수를 부여하지 않는다." style="text;html=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1320" height="24" as="geometry"/></mxCell>
        <mxCell id="fact" value="■ 스펙으로 확정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="measure" value="□ 동일 하니스로 측정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="88" width="180" height="26" as="geometry"/></mxCell>

        <mxCell id="h0" value="Architect 관점" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="255" height="44" as="geometry"/></mxCell>
        <mxCell id="h1" value="방안 1-A · 순차 SAO 투표형" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="455" height="44" as="geometry"/></mxCell>
        <mxCell id="h2" value="방안 2 · 누적 공통제안형" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="765" y="140" width="455" height="44" as="geometry"/></mxCell>
        <mxCell id="h3" value="해석" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1220" y="140" width="225" height="44" as="geometry"/></mxCell>

        <mxCell id="r1a" value="■ 합의 증거" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="184" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r1b" value="현재 라운드 후보에 대한 전원 O" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="184" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r1c" value="누적 제안 집합의 전원 교집합" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="184" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r1d" value="만장일치의 의미가 다름" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="184" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r2a" value="■ 통신 비용 / round" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="249" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r2b" value="2 phase · 2(N-1)건&#10;offer + (O/X + 다음 제안)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="249" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r2c" value="1 phase · N-1건&#10;후보 제출만" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="249" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r2d" value="2가 round당 메시지·phase 적음" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="249" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r3a" value="■ 성립 시점 규칙" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="314" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r3b" value="한 사람의 후보에 나머지가 O만 주어도 성립" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="314" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r3c" value="전원이 같은 후보를 직접 제안해야 성립" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="314" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r3d" value="1-A가 같거나 더 이른 round에 닫힘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="314" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r4a" value="■ 동률 해소 정보" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="379" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r4b" value="후보별 전원 순위 없음&#10;→ 결선투표 1회" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="379" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r4c" value="제출 round=순위 정보 보유&#10;→ 순위 합 → 표준편차 → 결선투표" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="379" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r4d" value="2가 결정론적 해소 정보를 더 보유" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="379" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r5a" value="■ 일반 참여자 노출" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="444" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r5b" value="익명 후보 목록은 보지만&#10;제안자 귀속·다른 O/X는 못 봄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="444" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r5c" value="다른 참여자의 제안·순위를 못 봄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="444" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r5d" value="두 방안 모두 참여자 간 귀속 노출 없음" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="444" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r6a" value="■ 메시지 유실 단위" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="509" width="255" height="65" as="geometry"/></mxCell>
        <mxCell id="r6b" value="reply 1건 유실&#10;= O/X + 다음 제안 동시 유실" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="509" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r6c" value="submit 1건 유실&#10;= 해당 라운드 후보 1개 유실" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="509" width="455" height="65" as="geometry"/></mxCell>
        <mxCell id="r6d" value="1-A의 결합 페이로드가 영향 범위 확대" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="509" width="225" height="65" as="geometry"/></mxCell>

        <mxCell id="r7a" value="□ Functional Correctness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="574" width="255" height="70" as="geometry"/></mxCell>
        <mxCell id="r7b" value="빠리 닫혀 더 낮은 Total Utility에 멈추는지 측정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="574" width="455" height="70" as="geometry"/></mxCell>
        <mxCell id="r7c" value="보수적 성립이 더 높은 Total Utility를 찾는지 측정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="574" width="455" height="70" as="geometry"/></mxCell>
        <mxCell id="r7d" value="사전 결론 금지&#10;동일 seed·profile 비교" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="574" width="225" height="70" as="geometry"/></mxCell>

        <mxCell id="r8a" value="□ Scalability / Resource" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#cccccc;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="644" width="255" height="70" as="geometry"/></mxCell>
        <mxCell id="r8b" value="N 증가 시 메시지 확장 지수·피크 메모리 측정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="310" y="644" width="455" height="70" as="geometry"/></mxCell>
        <mxCell id="r8c" value="N 증가 시 메시지 확장 지수·누적 상태 메모리 측정" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="644" width="455" height="70" as="geometry"/></mxCell>
        <mxCell id="r8d" value="round당 식과 전체 실측값을 구분" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1220" y="644" width="225" height="70" as="geometry"/></mxCell>

        <mxCell id="leftConclusion" value="1-A가 받는 구조적 이득&#10;• 수락 가능성을 즉시 물어 조기 성립 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontStyle=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="160" y="755" width="520" height="82" as="geometry"/></mxCell>
        <mxCell id="rightConclusion" value="2가 받는 구조적 이득&#10;• 메시지·phase 감소&#10;• 전원 순위를 이용한 동률 해소" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="820" y="755" width="520" height="82" as="geometry"/></mxCell>
        <mxCell id="bottom" value="선택 원칙  │  성립 규칙이 만드는 품질 차이는 FC 측정으로, 구조가 만드는 통신·노출·유실 차이는 스펙과 비용 측정으로 판단한다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="865" width="1140" height="55" as="geometry"/></mxCell>
