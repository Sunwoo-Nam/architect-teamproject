<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="consensus-state" name="03 합의 판정·상태 진화">
    <mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="방안 1-A vs 방안 2 — 합의 판정·상태 진화" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="동일한 선호 사례에서 ‘수락 표명’과 ‘직접 제안’이 성립 시점을 어떻게 바꾸는지를 비교한다." style="text;html=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1250" height="24" as="geometry"/></mxCell>
        <mxCell id="premise" value="예시 전제  │  X는 P1의 1순위, P2의 3순위, P3의 4순위이며 세 참여자 모두에게 revised threshold 이상이다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="92" width="1180" height="45" as="geometry"/></mxCell>
        <mxCell id="divider" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="160" as="sourcePoint"/><mxPoint x="750" y="880" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="headL" value="방안 1-A · 현재 라운드의 전원 O로 증명" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="680" height="40" as="geometry"/></mxCell>
        <mxCell id="candL" value="Round 1 제안 목록 C1&#10;P1 → X   ·   P2 → A   ·   P3 → B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="225" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="matrixL" value="&lt;b&gt;O/X 행렬&lt;/b&gt;&lt;br&gt;&lt;br&gt;             X       A       B&lt;br&gt;P1          O       X       O&lt;br&gt;P2          O       O       X&lt;br&gt;P3          O       X       O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=13;align=left;spacingLeft=55;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="315" width="360" height="190" as="geometry"/></mxCell>
        <mxCell id="formulaL" value="Accept1(c) = ∧i vote(i,c)&#10;&#10;Accept1(X) = O ∧ O ∧ O = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="330" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="decL" value="X 성립" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="145" height="70" as="geometry"/></mxCell>
        <mxCell id="edgeL1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="candL" target="matrixL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeL2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="matrixL" target="formulaL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeL3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="formulaL" target="decL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="timeL" value="R1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="565" width="100" height="55" as="geometry"/></mxCell>
        <mxCell id="stopL" value="즉시 종료&#10;P2·P3가 X를 직접 제안할 때까지 기다리지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="infoL" value="판정 정보: threshold 통과 여부만 알 수 있음&#10;후보별 전원 순위는 알 수 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="745" width="540" height="70" as="geometry"/></mxCell>

        <mxCell id="headR" value="방안 2 · 누적 제안 집합의 교집합으로 증명" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="680" height="40" as="geometry"/></mxCell>
        <mxCell id="r1" value="R1&#10;S1={X}&#10;S2={A}&#10;S3={B}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="125" height="105" as="geometry"/></mxCell>
        <mxCell id="r2" value="R2&#10;S1={X,C}&#10;S2={A,D}&#10;S3={B,E}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="125" height="105" as="geometry"/></mxCell>
        <mxCell id="r3" value="R3&#10;S1={X,C,F}&#10;S2={A,D,X}&#10;S3={B,E,G}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="125" height="105" as="geometry"/></mxCell>
        <mxCell id="r4" value="R4&#10;S1={X,C,F,H}&#10;S2={A,D,X,I}&#10;S3={B,E,G,X}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="250" width="130" height="105" as="geometry"/></mxCell>
        <mxCell id="er12" style="html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er23" style="html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er34" style="html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i1" value="∩Si = ∅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="380" width="115" height="35" as="geometry"/></mxCell>
        <mxCell id="i2" value="∩Si = ∅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="380" width="115" height="35" as="geometry"/></mxCell>
        <mxCell id="i3" value="∩Si = ∅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1145" y="380" width="115" height="35" as="geometry"/></mxCell>
        <mxCell id="i4" value="∩Si = {X}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1315" y="380" width="120" height="35" as="geometry"/></mxCell>
        <mxCell id="formulaR" value="G(k) = S1(k) ∩ S2(k) ∩ S3(k)&#10;&#10;G(1)=G(2)=G(3)=∅&#10;G(4)={X}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="455" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="decR" value="X 성립" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="480" width="145" height="70" as="geometry"/></mxCell>
        <mxCell id="edgeR" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="formulaR" target="decR"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="timeR" value="R4" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1070" y="610" width="100" height="55" as="geometry"/></mxCell>
        <mxCell id="stopR" value="P3가 X를 직접 제안할 때 종료&#10;‘수락 가능’만으로는 공통 제안으로 인정하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="690" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="infoR" value="판정 정보: 누가 어느 라운드에 후보를 제출했는지 축적&#10;라운드=순위이므로 순위 합 기반 동률 해소 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="785" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="bottom" value="결정적 차이  │  1-A의 증거는 ‘현재 O’이고, 2의 증거는 ‘과거부터 누적된 직접 제안’이다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="885" width="980" height="48" as="geometry"/></mxCell>
      </root>
